<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="4dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OlirumPlay"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_open_player"
            android:textColor="#00E5D4"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="34dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFF"
        android:contentDescription="Anterior" />

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="#00E5D4"
        android:contentDescription="@string/widget_play" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFFFF"
        android:contentDescription="Próxima" />
</LinearLayout>
